# Environment Configuration for AccessAble

# Application Settings
APP_NAME=AccessAble
APP_VERSION=1.0.0
DEBUG=true

# Database
DATABASE_URL=sqlite:///./accessable.db

# Confirmation timeout in minutes
CONFIRMATION_TIMEOUT_MINUTES=5

# Default user ID (single-user mode for now)
DEFAULT_USER_ID=1

# Server settings
HOST=127.0.0.1
PORT=8000
